# Security headers for Apache hosting (needs mod_headers).
# Agar aap Netlify / Cloudflare Pages par deploy kar rahe hain to `_headers` file kaafi hai.

AddDefaultCharset UTF-8
Options -Indexes

# SVG, CSS aur JS ke correct MIME types
AddType image/svg+xml .svg
AddType text/css .css
AddType application/javascript .js

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  # HSTS ko sirf HTTPS enable hone ke baad on karein (ya env=HTTPS use karein)
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# Dotfiles (jaise .htaccess, .git) ko block karein
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Browser caching (optional)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
</IfModule>

# HTTPS redirect — SSL certificate install hone ke baad in lines ko uncomment karein
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# </IfModule>
